# ==============================================================================
# 환경 변수 예시 파일
#
# - 필요한 환경에 맞춰 이 파일을 .env.local, .env.dev, .env.prod로 복사한다.
# - 실제 값은 복사한 파일에만 입력한다.
# - 운영 시크릿, 접근 키, 비밀번호는 이 예시 파일에 적지 않는다.
#
# .env.dev 값 기준
# - 개발 서버에서 Compose를 실행할 때는 컨테이너 이름을 호스트로 사용한다.
# - 개발자 PC에서 `make be-dev-up`을 실행할 때는 개발 서버 주소나 터널 주소를 사용한다.
# ==============================================================================

# ------------------------------------------------------------------------------
# Spring Boot
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=
SERVER_PORT=

# ------------------------------------------------------------------------------
# PostgreSQL / PostGIS
# ------------------------------------------------------------------------------
POSTGRES_DB=
POSTGRES_PORT=
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JPA_DDL_AUTO=

# ------------------------------------------------------------------------------
# Redis / ElastiCache
# ------------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=

# ------------------------------------------------------------------------------
# MinIO
#
# - dev/local에서는 AWS S3 대신 MinIO를 사용한다.
# - backend container에는 compose/script가 S3 호환 변수로 매핑한다.
# ------------------------------------------------------------------------------
MINIO_API_PORT=
MINIO_CONSOLE_PORT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=
MINIO_ENDPOINT=
MINIO_REGION=

# ------------------------------------------------------------------------------
# GraphHopper
#
# - dev 목표 구조는 PostgreSQL LineString 데이터를 참조하는 런타임이다.
# - 아래 파일 기반 변수는 local/PoC 호환용이며 dev env에서는 비워둘 수 있다.
# ------------------------------------------------------------------------------
GRAPHHOPPER_PORT=
GRAPHHOPPER_ADMIN_PORT=
GRAPHHOPPER_DATA_DIR=
GRAPHHOPPER_DATA_FILE=
GRAPHHOPPER_GRAPH_LOCATION=
GRAPHHOPPER_BASE_URL=

# ------------------------------------------------------------------------------
# 로컬 WAS -> dev 서버 터널
#
# - `make be-dev-up`에서 로컬 WAS를 dev DB/Redis/MinIO에 붙일 때 사용한다.
# - SSH key와 실제 접속 정보는 저장소에 올리지 않는다.
# - 아래 포트는 로컬 PC에서만 열리는 터널 포트다.
# ------------------------------------------------------------------------------
BE_DEV_TUNNEL_AUTO=
BE_DEV_SSH_HOST=
BE_DEV_SSH_KEY=
BE_DEV_DB_LOCAL_PORT=
BE_DEV_REDIS_LOCAL_PORT=
BE_DEV_MINIO_LOCAL_PORT=
BE_DEV_GRAPHHOPPER_LOCAL_PORT=

# ------------------------------------------------------------------------------
# Kakao SDK
# ------------------------------------------------------------------------------
KAKAO_JAVASCRIPT_KEY=

# ------------------------------------------------------------------------------
# ODsay 대중교통 API
# ------------------------------------------------------------------------------
ODSAY_API_BASE_URL=
ODSAY_API_KEY=
ODSAY_SERVER_IP=

# ------------------------------------------------------------------------------
# 공공데이터포털 공통 서비스키
#
# - ENCODING 값은 URL query에 그대로 넣는 용도다.
# - DECODING 값은 서버 내부에서 직접 인코딩해서 사용할 때만 쓴다.
# ------------------------------------------------------------------------------
PUBLIC_DATA_PORTAL_SERVICE_KEY_ENCODING=
PUBLIC_DATA_PORTAL_SERVICE_KEY_DECODING=

# ------------------------------------------------------------------------------
# 부산 BIMS API
# ------------------------------------------------------------------------------
BUSAN_BIMS_API_BASE_URL=
BUSAN_BIMS_SERVICE_KEY_ENCODING=
BUSAN_BIMS_SERVICE_KEY_DECODING=
